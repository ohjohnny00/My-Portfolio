---

interface Project {
  title: string;
  image: string;
  gallery?: string[];
  link: string;
  preview: string;
  status: string;
}

const projects: Project[] = [ 
  
  {
    title: "RepReady",
    image: "/projects/REP.jpg",
    gallery: ["/projects/REP.jpg", "/projects/REP2.jpg", "/projects/REP3.jpg"],
    link: "https://github.com",
    preview: "https://repready-gym.vercel.app/",
    status: "On Development",
  },
  {
    title: "Enterprise Resource Planning",
    image: "/projects/HRMS.png",
    gallery: ["/projects/HRMS.png", "/projects/FMS.png", "/projects/POS.png"],
    link: "https://github.com",
    preview: "https://portforlio-1cqq.onrender.com/hrms/login",
    status: "Deployed",
  },

];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="scroll-animate text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <h3 class="scroll-animate text-4xl md:text-5xl font-medium mb-8">Projects</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      {
        projects.map((project) => (
          <div class="group project-card scroll-reveal rounded-3xl border border-[#ffffff10] bg-[#111111]/30 p-4 shadow-[0_12px_30px_rgba(0,0,0,0.18)] backdrop-blur-sm transition-all duration-300 hover:border-[#ffffff1c] hover:shadow-[0_18px_42px_rgba(0,0,0,0.26)]">
            {project.gallery ? (
              <div class="erp-stack-stage mb-5">
                {project.gallery.map((image, index) => (
                  <button
                    type="button"
                    class={`erp-stack-image erp-stack-image-${index}`}
                    data-lightbox-src={image}
                    data-lightbox-alt={`${project.title} screenshot ${index + 1}`}
                    aria-label={`View ${project.title} screenshot ${index + 1}`}
                  >
                    <img src={image} alt="" loading="lazy" />
                  </button>
                ))}
              </div>
            ) : (
              <a
                href={project.preview}
                target="_blank"
                rel="noopener noreferrer"
                class="block mb-4"
              >
                <div class="rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-48 md:h-72 object-cover object-center group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
              </a>
            )}
              <div class="flex items-center px-1 pt-1">
                <div class="flex-grow">
                  <h4 class="text-2xl font-semibold tracking-[-0.03em] text-white/95">{project.title}</h4>
                  <span class="inline-flex items-center rounded-full border border-[#ffffff14] bg-white/5 px-2.5 py-1 text-xs font-medium text-[var(--white-icon)] uppercase tracking-[0.12em]">
                    {project.status}
                  </span>
                </div>
                <div class="flex gap-2 ml-auto">
                  <a
                    target="_blank"
                    href={project.link}
                    aria-label="GitHub"
                    class="size-11 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[#ffffff14] p-2.5 rounded-xl bg-[#1414149c] hover:bg-[#1b1b1b]"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-7"
                    >
                      <path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z" />
                    </svg>
                  </a>
                  <a
                    target="_blank"
                    href={project.preview}
                    aria-label="Preview"
                    class="size-11 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[#ffffff14] p-2.5 rounded-xl bg-[#1414149c] hover:bg-[#1b1b1b]"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-7"
                    >
                      <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                    </svg>
                  </a>
                </div>
              </div>
          </div>
        ))
      }
    </div>
    <dialog class="erp-lightbox" aria-label="Project screenshot">
      <img class="erp-lightbox-image" alt="" />
    </dialog>
    <a
      target="_blank"
      href="https://github.com/ohjohnny00"
      aria-label="GitHub"
      class="scroll-reveal w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
    >
      <span class="md:text-lg text-md">More projects on</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
        ></path>
      </svg>
    </a>
  </div>
</section>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>(".erp-lightbox");
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>("img");
  let previousDocumentOverflow = "";
  let previousBodyOverflow = "";

  document.querySelectorAll<HTMLButtonElement>("[data-lightbox-src]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!lightbox || !lightboxImage) return;
      lightboxImage.src = button.dataset.lightboxSrc ?? "";
      lightboxImage.alt = button.dataset.lightboxAlt ?? "Project screenshot";
      previousDocumentOverflow = document.documentElement.style.overflow;
      previousBodyOverflow = document.body.style.overflow;
      lightbox.showModal();
      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";
    });
  });

  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) lightbox.close();
  });

  lightbox?.addEventListener("close", () => {
    document.documentElement.style.overflow = previousDocumentOverflow;
    document.body.style.overflow = previousBodyOverflow;
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && lightbox?.open) lightbox.close();
  });

</script>

<style>
  .erp-stack-stage {
    position: relative;
    width: min(100%, 540px);
    margin-inline: auto;
    height: auto;
    aspect-ratio: 1.48 / 1;
    perspective: 1100px;
    isolation: isolate;
    filter: none;
    transform: translateY(8px);
    opacity: 0.96;
  }

  .is-visible .erp-stack-stage {
    transform: translateY(0);
    opacity: 1;
    transition: transform 700ms ease, opacity 700ms ease;
  }

  .erp-stack-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: 18px;
    background: rgba(17, 17, 17, 0.28);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);
    cursor: zoom-in;
    transition: transform 450ms cubic-bezier(0.175, 0.885, 0, 1), box-shadow 450ms ease, border-color 300ms ease;
  }

  .erp-stack-image img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    border-radius: 18px;
    transition: transform 500ms ease, filter 500ms ease;
  }

  .project-card:nth-child(1) .erp-stack-image-0 {
    z-index: 1;
    transform: translate3d(52px, -10px, -50px) rotateY(-12deg) rotateZ(3.8deg) scale(0.98);
  }

  .project-card:nth-child(1) .erp-stack-image-1 {
    z-index: 2;
    transform: translate3d(-36px, 10px, -22px) rotateY(10deg) rotateZ(-2.5deg) scale(0.985);
  }

  .project-card:nth-child(1) .erp-stack-image-2 {
    z-index: 3;
    transform: translate3d(0, 0, 0) rotateY(-3deg) scale(1);
  }

  .project-card:nth-child(2) .erp-stack-image-0 {
    z-index: 1;
    transform: translate3d(52px, -10px, -50px) rotateY(-12deg) rotateZ(3.8deg) scale(0.98);
  }

  .project-card:nth-child(2) .erp-stack-image-1 {
    z-index: 2;
    transform: translate3d(-36px, 10px, -22px) rotateY(10deg) rotateZ(-2.5deg) scale(0.985);
  }

  .project-card:nth-child(2) .erp-stack-image-2 {
    z-index: 3;
    transform: translate3d(0, 0, 0) rotateY(-3deg) scale(1);
  }

  .erp-stack-image::before {
    content: "";
    position: absolute;
    z-index: 2;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(0deg, transparent, transparent 30%, rgb(0 255 255 / 48%));
    opacity: 0;
    pointer-events: none;
    transform: rotate(-45deg) translateY(-65%);
  }

  .erp-stack-image:is(:hover, :focus-visible) {
    z-index: 4;
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: 0 16px 28px rgba(0, 0, 0, 0.18);
    transform: translate3d(0, -6px, 0) rotateY(0deg) rotateZ(0deg) scale(1.01);
  }

  .erp-stack-image:is(:hover, :focus-visible) img {
    transform: scale(1.02);
    filter: brightness(1.03);
  }

  .erp-stack-image:is(:hover, :focus-visible)::before {
    animation: holographic-sweep 1.8s ease-in-out infinite;
  }

  .erp-lightbox {
    position: fixed;
    inset: 0;
    box-sizing: border-box;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: transparent;
  }

  .erp-lightbox[open] {
    display: grid;
    place-items: center;
    animation: lightbox-fade 420ms ease-out both;
  }

  .erp-lightbox::backdrop {
    background: rgb(0 0 0 / 86%);
    animation: backdrop-flash 420ms ease-out both;
  }

  .erp-lightbox-image {
    display: block;
    width: auto;
    height: auto;
    max-width: min(92vw, 1100px);
    max-height: 90vh;
    object-fit: contain;
    object-position: center;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 10px;
    box-shadow: 0 24px 90px rgb(0 0 0 / 60%);
    animation: lightbox-flash 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  @media (max-width: 480px) {
    .erp-stack-image-0 {
      transform: translate3d(30px, -11px, -55px) rotateY(-13deg) rotateZ(4deg);
    }

    .erp-stack-image-1 {
      transform: translate3d(-25px, 5px, -25px) rotateY(10deg) rotateZ(-3deg);
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .erp-stack-image,
    .erp-stack-image::before,
    .erp-lightbox[open],
    .erp-lightbox-image,
    .erp-lightbox::backdrop {
      animation-duration: 0.01ms;
      transition-duration: 0.01ms;
    }
  }

  @keyframes lightbox-flash {
    from { opacity: 0; transform: scale(0.94); filter: brightness(2.2); }
    to { opacity: 1; transform: scale(1); filter: brightness(1); }
  }

  @keyframes lightbox-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes backdrop-flash {
    from { background: rgb(255 255 255 / 88%); }
    to { background: rgb(0 0 0 / 86%); }
  }

  @keyframes holographic-sweep {
    0% { opacity: 0; transform: rotate(-45deg) translateY(-65%); }
    16%, 78% { opacity: 1; }
    100% { opacity: 0; transform: rotate(-45deg) translateY(105%); }
  }
</style>
