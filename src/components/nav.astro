---
interface NavItem {
  label: string;
  href: string;
  icon: string;
}

const navItems: NavItem[] = [
  {
    label: "Home",
    href: "#home",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M21 20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20ZM19 19V9.97815L12 4.53371L5 9.97815V19H19Z"></path></svg>`,
  },
  {
    label: "Projects",
    href: "#projects",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M4 5V19H20V7H11.5858L9.58579 5H4ZM12.4142 5H21C21.5523 5 22 5.44772 22 6V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H10.4142L12.4142 5Z"></path></svg>`,
  },
  {
    label: "Contact",
    href: "#contact",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"></path></svg>`,
  },
];
---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    class="fixed left-1/2 -translate-x-1/2 z-[100] border border-transparent bg-[#0f0f0f]/80 backdrop-blur-xl transition-all duration-500 ease-in-out md:top-6 md:bottom-auto bottom-0 w-[min(92vw,680px)] rounded-full shadow-[0_8px_30px_rgba(0,0,0,0.22)]"
  >
    <div class="mx-auto flex items-center justify-center px-3 py-2.5 md:px-6">
      <ul class="flex w-full items-center justify-between gap-3 md:justify-center md:gap-8">
        {
          navItems.map((item, index) => (
            <li class="flex-1 md:flex-none">
              <a
                href={item.href}
                class={`relative flex items-center justify-center gap-2 text-[var(--white-icon)] transition-colors duration-300 text-xs md:text-base ${index === 0 ? "active" : ""}`}
              >
                <span class="nav-indicator hidden md:inline-flex h-2.5 w-2.5 rounded-full bg-[var(--sec)] opacity-0 scale-0 transition-all duration-300" />
                <span class="md:hidden flex items-center justify-center w-5 h-5">
                  <fragment set:html={item.icon} />
                </span>
                <span class="inline-block">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</div>
<style>
  nav {
    transform: translateX(-50%);
    width: min(92vw, 680px);
    transition:
      width 0.35s ease,
      background-color 0.3s ease,
      border-radius 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  nav.scrolling {
    width: min(82vw, 620px);
    background-color: rgba(20, 20, 20, 0.9);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.26);
  }

  nav a {
    color: rgba(243, 243, 243, 0.72);
  }

  nav a.active {
    color: rgba(255, 255, 255, 1) !important;
  }

  nav a.active .nav-indicator {
    display: inline-flex;
    opacity: 1;
    transform: scale(1);
  }

  html {
    scroll-behavior: smooth;
  }

  @media (max-width: 767px) {
    nav {
      width: min(96vw, 520px) !important;
      bottom: 0.75rem;
      left: 50%;
      border-radius: 9999px;
      border-color: rgba(255, 255, 255, 0.08);
    }

    nav.scrolling {
      background-color: rgba(20, 20, 20, 0.92);
    }

    body {
      padding-bottom: 78px;
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");
  const navLinks = document.querySelectorAll("nav a[href^='#']");
  let lastActiveId: string | null = null;
  let navigationTarget: string | null = null;
  let navigationFallback: number | null = null;

  const setActiveLink = (id: string | null) => {
    if (!id || id === lastActiveId) return;

    lastActiveId = id;
    navLinks.forEach((link) => link.classList.remove("active"));

    const activeLink = document.querySelector(`nav a[href="#${id}"]`);
    if (activeLink) {
      activeLink.classList.add("active");
    }
  };

  let scrollTick: number | null = null;

  function updateNav() {
    if (window.scrollY > 0) {
      nav?.classList.add("scrolling");
    } else {
      nav?.classList.remove("scrolling");
    }
    scrollTick = null;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!scrollTick) {
        scrollTick = requestAnimationFrame(updateNav);
      }
    },
    { passive: true }
  );

  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      e.preventDefault();
      const target = e.currentTarget as HTMLAnchorElement;
      const targetId = target.getAttribute("href")?.substring(1) || "";
      const targetElement = document.getElementById(targetId);

      if (targetId) {
        navigationTarget = targetId;
        setActiveLink(targetId);
        if (navigationFallback !== null) {
          window.clearTimeout(navigationFallback);
        }
        navigationFallback = window.setTimeout(() => {
          navigationTarget = null;
          navigationFallback = null;
        }, 1500);
      }

      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id]");
    const observerOptions = { threshold: [0.3, 0.6, 0.9] };

    if (sections.length > 0) {
      setActiveLink("home");
    }

    const observerCallback = (entries: IntersectionObserverEntry[]) => {
      if (navigationTarget) return;

      const visibleEntries = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

      if (visibleEntries.length > 0) {
        const topSectionId = visibleEntries[0].target.getAttribute("id");
        if (topSectionId) {
          setActiveLink(topSectionId);
        }
      }
    };

    const observer = new IntersectionObserver(
      observerCallback,
      observerOptions
    );
    sections.forEach((section) => observer.observe(section));
  });

  window.addEventListener("scrollend", () => {
    if (navigationTarget) {
      setActiveLink(navigationTarget);
      navigationTarget = null;
      if (navigationFallback !== null) {
        window.clearTimeout(navigationFallback);
        navigationFallback = null;
      }
    }
  });
</script>

<style>
  @media (max-width: 767px) {
    body {
      padding-bottom: 70px;
    }
  }

  nav a.active {
    color: white !important;
  }
</style>
