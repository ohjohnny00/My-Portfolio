---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Portfolio</title>
    <meta
      name="description"
      content="Ilagan Ruben F is a BSIT student and frontend developer building responsive web applications and interactive digital experiences."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content="Ilagan Ruben F | Frontend Developer"
    />
    <meta
      property="og:description"
      content="Portfolio of Ilagan Ruben F, a BSIT student building responsive web applications and interactive frontend experiences."
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Ilagan Ruben F Portfolio"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Ilagan Ruben F",
        "sameAs": [
          "https://github.com/ohjohnny00",
          "https://www.facebook.com/ohwbenny00"
        ],
        "jobTitle": "Frontend Developer",
        "description": "BSIT student building responsive web applications and interactive frontend experiences."
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
    <script>
      const revealTargets = document.querySelectorAll(
        ".scroll-animate, .scroll-reveal"
      );

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle("is-visible", entry.isIntersecting);
          });
        },
        {
          threshold: 0.01,
          rootMargin: "-4% 0px -8% 0px",
        }
      );

      revealTargets.forEach((target) => revealObserver.observe(target));
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }

  .scroll-animate,
  .scroll-reveal {
    opacity: 0;
    transform: translate3d(0, 22px, 0);
    filter: blur(3px);
    transition:
      opacity 650ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 650ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .scroll-animate.is-visible,
  .scroll-reveal.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    filter: blur(0);
  }

  .scroll-animate + .scroll-animate,
  .scroll-reveal:nth-child(2) {
    transition-delay: 90ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-animate,
    .scroll-reveal {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }
</style>
